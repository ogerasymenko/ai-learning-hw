# Copy this file to .env (setup.sh does it for you) and put your key in.

# Free, no credit card: create a key at https://console.groq.com/keys
GROQ_API_KEY=...
MODEL=groq:openai/gpt-oss-120b

# Or use a paid provider instead:
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=anthropic:claude-haiku-5-5
# OPENAI_API_KEY=sk-...
# MODEL=openai:<model>
