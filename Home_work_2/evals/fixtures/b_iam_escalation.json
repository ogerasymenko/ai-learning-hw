{
  "format_version": "1.2",
  "terraform_version": "1.9.5",
  "resource_changes": [
    {
      "address": "aws_iam_policy.app",
      "type": "aws_iam_policy",
      "name": "app",
      "change": {
        "actions": [
          "delete",
          "create"
        ],
        "before": {
