{
  "format_version": "1.2",
  "terraform_version": "1.9.5",
  "resource_changes": [
    {
      "address": "aws_security_group.web",
      "type": "aws_security_group",
      "name": "web",
      "change": {
        "actions": ["update"],
        "before": {"ingress": [{"cidr_blocks": ["10.0.0.0/16"], "from_port": 443, "to_port": 443}]},
        "after": {"ingress": [{"cidr_blocks": ["0.0.0.0/0"], "from_port": 443, "to_port": 443}]}
      }
    },
    {
      "address": "aws_db_instance.main",
      "type": "aws_db_instance",
      "name": "main",
      "change": {
        "actions": ["update"],
        "before": {"instance_class": "db.t3.micro"},
        "after": {"instance_class": "db.t3.medium"}
      }
    },
    {
      "address": "aws_db_subnet_group.legacy",
      "type": "aws_db_subnet_group",
      "name": "legacy",
      "change": {
        "actions": ["delete"],
        "before": {"name": "legacy-db"},
        "after": null
      }
    },
    {
      "address": "aws_iam_policy.app",
      "type": "aws_iam_policy",
      "name": "app",
      "change": {
        "actions": ["delete", "create"],
        "before": {"policy": "read-only"},
        "after": {"policy": "read-write"},
        "replace_paths": [["policy"]]
      }
    },
    {
      "address": "aws_s3_bucket.config",
      "type": "aws_s3_bucket",
      "name": "config",
      "change": {
        "actions": ["create"],
        "before": null,
        "after": {"bucket": "platform-config"}
      }
    }
  ]
}
